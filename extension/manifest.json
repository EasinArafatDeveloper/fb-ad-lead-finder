{
  "manifest_version": 3,
  "name": "FB Ad Lead Finder",
  "version": "3.6.1",
  "description": "Collect active advertisers from the Meta Ad Library into your FB Lead Finder dashboard, with their public business contacts.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "proxy",
    "webRequest",
    "webNavigation",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FB Ad Lead Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "content/adlibrary-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "content/adlibrary.js"
      ],
      "css": [
        "content/adlibrary.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://specter.monster/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
