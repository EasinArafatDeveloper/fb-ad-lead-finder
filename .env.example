# Copy to .env (chmod 600). Never commit .env.
# Own database user on the shared MongoDB container (never the admin account)
MONGODB_URI=mongodb://fb_leads:<password>@mongodb:27017/fb_ad_leads?authSource=fb_ad_leads
DB_NAME=fb_ad_leads
# The Chrome extension (worker) uses this key — long random text
WORKER_KEY=change-me-to-a-long-random-string
# true = anybody can create an account on the login page; false = only admins create users
ALLOW_SIGNUP=false
